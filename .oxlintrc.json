{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "import", "unicorn"],
  // Our own rules (lint/): JS plugins are in alpha, so oxlint's version is pinned.
  "jsPlugins": ["./lint/plugin.mjs"],
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": ["node_modules", "dist"],
  "rules": {
    // A parameter's empty `{}` is the shape its caller sets (a Playwright fixture that depends on no other).
    "no-empty-pattern": ["error", { "allowObjectPatternsAsParameters": true }],

    // TypeScript
    // A rest parameter may be `any[]`, which TypeScript requires of a mixin's constructor (TS2545); nothing else is `any`.
    "typescript/no-explicit-any": ["error", { "ignoreRestArgs": true }],
    // TypeScript's errors are fixed, never silenced: no @ts-expect-error, @ts-ignore or @ts-nocheck.
    "typescript/ban-ts-comment": ["error", { "ts-expect-error": true, "ts-ignore": true, "ts-nocheck": true }],
    "typescript/consistent-type-imports": ["error", { "fixStyle": "inline-type-imports" }],
    "typescript/no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_"
      }
    ],

    // React
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    // React Compiler rules. The compiler isn't enabled, so APIs it can't memoize (react-hook-form's watch()) are fine.
    // State a prop drives is reset in the render that sees it change (`useOnChange`), never by an effect.
    "react/incompatible-library": "off",
    "react/set-state-in-effect": "error",

    // Unicorn
    "unicorn/no-array-for-each": "error",
    "unicorn/no-new-array": "off",
    "unicorn/no-single-promise-in-promise-methods": "off",
    "unicorn/no-useless-fallback-in-spread": "off",
    "unicorn/no-useless-spread": "off",

    // General
    "no-console": "error",
    "import/no-empty-named-blocks": "error",
    // Routers, services and repositories in CRUD order (lint/memberOrder.mjs): `bun run lint --fix` sorts them.
    "arkyvree/member-order": "error",
    // A public method starts with a verb its layer knows (lint/methodNames.mjs): repositories, services, policies.
    "arkyvree/method-names": "error",
    // An exported function of the server or shared/ starts with a verb (lint/methodNames.mjs).
    "arkyvree/function-names": "error",
    // The architecture (lint/architecture.mjs): what each layer imports, where queries are built, folder indexes.
    "arkyvree/layers": "error",
    "arkyvree/queries-in-repositories": "error",
    "arkyvree/folder-index": "error",
    // AGENTS.md's conventions (lint/conventions.mjs): imports through @/, no helpers.ts, the shared repository
    // instances, route params / validation / errors, sorting through the repository, shared/'s runtime, `session`,
    // the environment read in server/environment.ts, repository writes inside a transaction.
    "arkyvree/no-parent-imports": "error",
    "arkyvree/no-helpers-modules": "error",
    "arkyvree/repository-instances": "error",
    "arkyvree/route-conventions": "error",
    "arkyvree/order-through-repository": "error",
    "arkyvree/shared-runtime": "error",
    "arkyvree/session-param": "error",
    "arkyvree/environment": "error",
    "arkyvree/no-disable-comments": "error",
    "arkyvree/writes-in-transactions": "error",
    "arkyvree/test-placement": "error",
    "arkyvree/concern-shape": "error",
    "arkyvree/comment-style": "error",
    "arkyvree/policy-shape": "error",
    "arkyvree/include-order": "error",
    "arkyvree/file-layout": "error",
    "arkyvree/function-declarations": "error",
    // The client's conventions (lint/frontend.mjs) and the tests' (lint/testing.mjs).
    "arkyvree/accessible-icon-buttons": "error",
    "arkyvree/dialog-conventions": "error",
    "arkyvree/query-keys": "error",
    "arkyvree/client-apis": "error",
    "arkyvree/controlled-inputs": "error",
    "arkyvree/effect-writes": "error",
    "arkyvree/api-calls-in-queries": "error",
    "arkyvree/error-alerts": "error",
    "arkyvree/date-formats": "error",
    "arkyvree/sx-styles": "error",
    "arkyvree/test-conventions": "error",
    // A function holds at most 80 of its own lines (lint/size.mjs): a longer one splits into named steps.
    "arkyvree/function-length": "error",
    // A file reads bottom-up: a helper sits above the code that uses it. Classes are left out (a repository's instance
    // class follows it), and so is a variable read inside a function, which runs once the file has loaded: drizzle's
    // tables point their foreign keys both ways.
    "no-use-before-define": [
      "error",
      { "functions": true, "classes": false, "variables": false, "enums": false, "typedefs": false, "ignoreTypeReferences": true }
    ],
    // The names inside an import, alphabetically. The formatter orders the imports themselves.
    "sort-imports": ["error", { "ignoreCase": true, "ignoreDeclarationSort": true }],
    // Frontend barrel imports
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "@mui/material",
            "importNames": ["CircularProgress", "Dialog"],
            "message": "Use DiceSpinner / CreateDialog / EditDialog / FormDialog from @/client/src/components/common instead. Raw MUI Dialog skips the dirty-form close block; raw CircularProgress is not used in this codebase."
          }
        ],
        "patterns": [
          {
            "group": [
              "@/client/src/components/*/*.ts",
              "@/client/src/components/*/*.tsx",
              "@/client/src/hooks/*.ts",
              "@/client/src/pages/*/components/*.ts",
              "@/client/src/pages/*/components/*.tsx",
              "@/client/src/pages/*/hooks/*.ts",
              "@/client/src/pages/*/hooks/*.tsx",
              "@/client/src/pages/*/details/components/*.ts",
              "@/client/src/pages/*/details/components/*.tsx",
              "@/client/src/pages/*/details/*/components/*.ts",
              "@/client/src/pages/*/details/*/components/*.tsx",
              "!**/index.ts"
            ],
            "message": "Import from the barrel index instead."
          }
        ]
      }
    ]
  },
  "overrides": [
    // Modal is the single sanctioned wrapper for raw MUI Dialog; the rest of the
    // codebase must go through Modal/FormDialog/CreateDialog/EditDialog. The
    // wrappers themselves compose with each other, so they need to import
    // siblings directly (importing through the barrel would be circular).
    {
      "files": [
        "client/src/components/common/Modal.tsx",
        "client/src/components/common/FormDialog.tsx",
        "client/src/components/common/StandardDialogs.tsx"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    // No default exports in shared components/hooks/contexts/stores/services
    {
      "files": [
        "client/src/components/**/*.{ts,tsx}",
        "client/src/hooks/**/*.ts",
        "client/src/contexts/**/*.{ts,tsx}",
        "client/src/stores/**/*.ts",
        "client/src/services/**/*.ts",
        "client/src/pages/*/components/**/*.{ts,tsx}",
        "client/src/pages/*/hooks/**/*.ts",
        "client/src/pages/*/details/components/**/*.{ts,tsx}",
        "client/src/pages/*/details/*/components/**/*.{ts,tsx}",
        "client/src/pages/*/details/*/sections/**/*.{ts,tsx}",
        "client/src/pages/*/details/sections/**/*.{ts,tsx}",
        "client/src/pages/*/customization/sections/**/*.{ts,tsx}"
      ],
      "rules": {
        "import/no-default-export": "error"
      }
    },
    // Fast Refresh reloads the client's components as they're edited: a module of them exports components only
    {
      "files": ["client/**/*.{ts,tsx}"],
      "rules": {
        "react/only-export-components": ["error", { "allowConstantExport": true }]
      }
    },
    // Server/scripts/tests/database: allow console
    {
      "files": ["server/**/*.{ts,tsx}", "scripts/**/*.ts", "tests/**/*.ts", "database/**/*.ts"],
      "rules": {
        "no-console": "off"
      }
    },
    // API routers: no direct repo/db access, use service barrel imports
    {
      "files": ["server/routers/api/**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/server/repositories/index.ts", "@/server/repositories/index"],
                "message": "API routers must not use repositories directly. Delegate to a service instead."
              },
              {
                "group": ["@/server/database/*"],
                "message": "API routers must not use the database directly. Delegate to a service instead."
              },
              {
                "group": [
                  "@/server/services/campaigns/*",
                  "@/server/services/characters/*",
                  "@/server/services/rulesets/*",
                  "!@/server/services/campaigns/index",
                  "!@/server/services/campaigns/index.ts",
                  "!@/server/services/characters/index",
                  "!@/server/services/characters/index.ts",
                  "!@/server/services/rulesets/index",
                  "!@/server/services/rulesets/index.ts"
                ],
                "message": "Import services from the barrel index (e.g., @/server/services/campaigns/index.ts)."
              },
              {
                "group": [
                  "@/server/middlewares/*",
                  "!@/server/middlewares/index",
                  "!@/server/middlewares/index.ts"
                ],
                "message": "Import middlewares from the barrel index (@/server/middlewares/index.ts)."
              }
            ]
          }
        ]
      }
    },
    // Services: use shared repo instances from index.ts
    {
      "files": ["server/services/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@/server/repositories/*",
                  "!@/server/repositories/index",
                  "!@/server/repositories/index.ts",
                  "!@/server/repositories/BaseRepository",
                  "!@/server/repositories/BaseRepository.ts"
                ],
                "message": "Import shared repository instances from @/server/repositories/index.ts instead of individual files."
              }
            ]
          }
        ]
      }
    },
    // Page isolation: each page domain cannot import from other page domains.
    // Keep this list in sync with the folders under client/src/pages.
    { "files": ["client/src/pages/activities/**/*.{ts,tsx}"], "rules": { "no-restricted-imports": ["error", { "patterns": [{ "group": ["@/client/src/pages/auth/**", "@/client/src/pages/campaign-invite/**", "@/client/src/pages/campaigns/**", "@/client/src/pages/character-contributor-invite/**", "@/client/src/pages/characters/**", "@/client/src/pages/dashboard/**", "@/client/src/pages/demo-expired/**", "@/client/src/pages/legal/**", "@/client/src/pages/notifications/**", "@/client/src/pages/profile/**", "@/client/src/pages/ruleset-contributor-invite/**", "@/client/src/pages/rulesets/**", "@/client/src/pages/settings/**", "@/client/src/pages/shared/**"], "message": "Pages must not import from other page domains." } ]} ]}},
    { "files": ["client/src/pages/auth/**/*.{ts,tsx}"], "rules": { "no-restricted-imports": ["error", { "patterns": [{ "group": ["@/client/src/pages/activities/**", "@/client/src/pages/campaign-invite/**", "@/client/src/pages/campaigns/**", "@/client/src/pages/character-contributor-invite/**", "@/client/src/pages/characters/**", "@/client/src/pages/dashboard/**", "@/client/src/pages/demo-expired/**", "@/client/src/pages/legal/**", "@/client/src/pages/notifications/**", "@/client/src/pages/profile/**", "@/client/src/pages/ruleset-contributor-invite/**", "@/client/src/pages/rulesets/**", "@/client/src/pages/settings/**", "@/client/src/pages/shared/**"], "message": "Pages must not import from other page domains." } ]} ]}},
    { "files": ["client/src/pages/campaign-invite/**/*.{ts,tsx}"], "rules": { "no-restricted-imports": ["error", { "patterns": [{ "group": ["@/client/src/pages/activities/**", "@/client/src/pages/auth/**", "@/client/src/pages/campaigns/**", "@/client/src/pages/character-contributor-invite/**", "@/client/src/pages/characters/**", "@/client/src/pages/dashboard/**", "@/client/src/pages/demo-expired/**", "@/client/src/pages/legal/**", "@/client/src/pages/notifications/**", "@/client/src/pages/profile/**", "@/client/src/pages/ruleset-contributor-invite/**", "@/client/src/pages/rulesets/**", "@/client/src/pages/settings/**", "@/client/src/pages/shared/**"], "message": "Pages must not import from other page domains." } ]} ]}},
    { "files": ["client/src/pages/campaigns/**/*.{ts,tsx}"], "rules": { "no-restricted-imports": ["error", { "patterns": [{ "group": ["@/client/src/pages/activities/**", "@/client/src/pages/auth/**", "@/client/src/pages/campaign-invite/**", "@/client/src/pages/character-contributor-invite/**", "@/client/src/pages/characters/**", "@/client/src/pages/dashboard/**", "@/client/src/pages/demo-expired/**", "@/client/src/pages/legal/**", "@/client/src/pages/notifications/**", "@/client/src/pages/profile/**", "@/client/src/pages/ruleset-contributor-invite/**", "@/client/src/pages/rulesets/**", "@/client/src/pages/settings/**", "@/client/src/pages/shared/**"], "message": "Pages must not import from other page domains." } ]} ]}},
    { "files": ["client/src/pages/character-contributor-invite/**/*.{ts,tsx}"], "rules": { "no-restricted-imports": ["error", { "patterns": [{ "group": ["@/client/src/pages/activities/**", "@/client/src/pages/auth/**", "@/client/src/pages/campaign-invite/**", "@/client/src/pages/campaigns/**", "@/client/src/pages/characters/**", "@/client/src/pages/dashboard/**", "@/client/src/pages/demo-expired/**", "@/client/src/pages/legal/**", "@/client/src/pages/notifications/**", "@/client/src/pages/profile/**", "@/client/src/pages/ruleset-contributor-invite/**", "@/client/src/pages/rulesets/**", "@/client/src/pages/settings/**", "@/client/src/pages/shared/**"], "message": "Pages must not import from other page domains." } ]} ]}},
    { "files": ["client/src/pages/characters/**/*.{ts,tsx}"], "rules": { "no-restricted-imports": ["error", { "patterns": [{ "group": ["@/client/src/pages/activities/**", "@/client/src/pages/auth/**", "@/client/src/pages/campaign-invite/**", "@/client/src/pages/campaigns/**", "@/client/src/pages/character-contributor-invite/**", "@/client/src/pages/dashboard/**", "@/client/src/pages/demo-expired/**", "@/client/src/pages/legal/**", "@/client/src/pages/notifications/**", "@/client/src/pages/profile/**", "@/client/src/pages/ruleset-contributor-invite/**", "@/client/src/pages/rulesets/**", "@/client/src/pages/settings/**", "@/client/src/pages/shared/**"], "message": "Pages must not import from other page domains." } ]} ]}},
    { "files": ["client/src/pages/dashboard/**/*.{ts,tsx}"], "rules": { "no-restricted-imports": ["error", { "patterns": [{ "group": ["@/client/src/pages/activities/**", "@/client/src/pages/auth/**", "@/client/src/pages/campaign-invite/**", "@/client/src/pages/campaigns/**", "@/client/src/pages/character-contributor-invite/**", "@/client/src/pages/characters/**", "@/client/src/pages/demo-expired/**", "@/client/src/pages/legal/**", "@/client/src/pages/notifications/**", "@/client/src/pages/profile/**", "@/client/src/pages/ruleset-contributor-invite/**", "@/client/src/pages/rulesets/**", "@/client/src/pages/settings/**", "@/client/src/pages/shared/**"], "message": "Pages must not import from other page domains." } ]} ]}},
    { "files": ["client/src/pages/demo-expired/**/*.{ts,tsx}"], "rules": { "no-restricted-imports": ["error", { "patterns": [{ "group": ["@/client/src/pages/activities/**", "@/client/src/pages/auth/**", "@/client/src/pages/campaign-invite/**", "@/client/src/pages/campaigns/**", "@/client/src/pages/character-contributor-invite/**", "@/client/src/pages/characters/**", "@/client/src/pages/dashboard/**", "@/client/src/pages/legal/**", "@/client/src/pages/notifications/**", "@/client/src/pages/profile/**", "@/client/src/pages/ruleset-contributor-invite/**", "@/client/src/pages/rulesets/**", "@/client/src/pages/settings/**", "@/client/src/pages/shared/**"], "message": "Pages must not import from other page domains." } ]} ]}},
    { "files": ["client/src/pages/legal/**/*.{ts,tsx}"], "rules": { "no-restricted-imports": ["error", { "patterns": [{ "group": ["@/client/src/pages/activities/**", "@/client/src/pages/auth/**", "@/client/src/pages/campaign-invite/**", "@/client/src/pages/campaigns/**", "@/client/src/pages/character-contributor-invite/**", "@/client/src/pages/characters/**", "@/client/src/pages/dashboard/**", "@/client/src/pages/demo-expired/**", "@/client/src/pages/notifications/**", "@/client/src/pages/profile/**", "@/client/src/pages/ruleset-contributor-invite/**", "@/client/src/pages/rulesets/**", "@/client/src/pages/settings/**", "@/client/src/pages/shared/**"], "message": "Pages must not import from other page domains." } ]} ]}},
    { "files": ["client/src/pages/notifications/**/*.{ts,tsx}"], "rules": { "no-restricted-imports": ["error", { "patterns": [{ "group": ["@/client/src/pages/activities/**", "@/client/src/pages/auth/**", "@/client/src/pages/campaign-invite/**", "@/client/src/pages/campaigns/**", "@/client/src/pages/character-contributor-invite/**", "@/client/src/pages/characters/**", "@/client/src/pages/dashboard/**", "@/client/src/pages/demo-expired/**", "@/client/src/pages/legal/**", "@/client/src/pages/profile/**", "@/client/src/pages/ruleset-contributor-invite/**", "@/client/src/pages/rulesets/**", "@/client/src/pages/settings/**", "@/client/src/pages/shared/**"], "message": "Pages must not import from other page domains." } ]} ]}},
    { "files": ["client/src/pages/profile/**/*.{ts,tsx}"], "rules": { "no-restricted-imports": ["error", { "patterns": [{ "group": ["@/client/src/pages/activities/**", "@/client/src/pages/auth/**", "@/client/src/pages/campaign-invite/**", "@/client/src/pages/campaigns/**", "@/client/src/pages/character-contributor-invite/**", "@/client/src/pages/characters/**", "@/client/src/pages/dashboard/**", "@/client/src/pages/demo-expired/**", "@/client/src/pages/legal/**", "@/client/src/pages/notifications/**", "@/client/src/pages/ruleset-contributor-invite/**", "@/client/src/pages/rulesets/**", "@/client/src/pages/settings/**", "@/client/src/pages/shared/**"], "message": "Pages must not import from other page domains." } ]} ]}},
    { "files": ["client/src/pages/ruleset-contributor-invite/**/*.{ts,tsx}"], "rules": { "no-restricted-imports": ["error", { "patterns": [{ "group": ["@/client/src/pages/activities/**", "@/client/src/pages/auth/**", "@/client/src/pages/campaign-invite/**", "@/client/src/pages/campaigns/**", "@/client/src/pages/character-contributor-invite/**", "@/client/src/pages/characters/**", "@/client/src/pages/dashboard/**", "@/client/src/pages/demo-expired/**", "@/client/src/pages/legal/**", "@/client/src/pages/notifications/**", "@/client/src/pages/profile/**", "@/client/src/pages/rulesets/**", "@/client/src/pages/settings/**", "@/client/src/pages/shared/**"], "message": "Pages must not import from other page domains." } ]} ]}},
    { "files": ["client/src/pages/rulesets/**/*.{ts,tsx}"], "rules": { "no-restricted-imports": ["error", { "patterns": [{ "group": ["@/client/src/pages/activities/**", "@/client/src/pages/auth/**", "@/client/src/pages/campaign-invite/**", "@/client/src/pages/campaigns/**", "@/client/src/pages/character-contributor-invite/**", "@/client/src/pages/characters/**", "@/client/src/pages/dashboard/**", "@/client/src/pages/demo-expired/**", "@/client/src/pages/legal/**", "@/client/src/pages/notifications/**", "@/client/src/pages/profile/**", "@/client/src/pages/ruleset-contributor-invite/**", "@/client/src/pages/settings/**", "@/client/src/pages/shared/**"], "message": "Pages must not import from other page domains." } ]} ]}},
    { "files": ["client/src/pages/settings/**/*.{ts,tsx}"], "rules": { "no-restricted-imports": ["error", { "patterns": [{ "group": ["@/client/src/pages/activities/**", "@/client/src/pages/auth/**", "@/client/src/pages/campaign-invite/**", "@/client/src/pages/campaigns/**", "@/client/src/pages/character-contributor-invite/**", "@/client/src/pages/characters/**", "@/client/src/pages/dashboard/**", "@/client/src/pages/demo-expired/**", "@/client/src/pages/legal/**", "@/client/src/pages/notifications/**", "@/client/src/pages/profile/**", "@/client/src/pages/ruleset-contributor-invite/**", "@/client/src/pages/rulesets/**", "@/client/src/pages/shared/**"], "message": "Pages must not import from other page domains." } ]} ]}},
    { "files": ["client/src/pages/shared/**/*.{ts,tsx}"], "rules": { "no-restricted-imports": ["error", { "patterns": [{ "group": ["@/client/src/pages/activities/**", "@/client/src/pages/auth/**", "@/client/src/pages/campaign-invite/**", "@/client/src/pages/campaigns/**", "@/client/src/pages/character-contributor-invite/**", "@/client/src/pages/characters/**", "@/client/src/pages/dashboard/**", "@/client/src/pages/demo-expired/**", "@/client/src/pages/legal/**", "@/client/src/pages/notifications/**", "@/client/src/pages/profile/**", "@/client/src/pages/ruleset-contributor-invite/**", "@/client/src/pages/rulesets/**", "@/client/src/pages/settings/**"], "message": "Pages must not import from other page domains." } ]} ]}}
  ]
}

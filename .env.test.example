# Local disposable test database only. Copy to .env.test.
# `bun test:db:reset` DELETES and recreates this database's contents; test runs use copies of it.
NODE_ENV=test
DATABASE_URL=postgresql://devuser:devpass@localhost:5433/arkyvree_test
PORT=8001
APP_URL=http://localhost:8001
SIGNING_SECRET=local-test-only-signing-secret
GOOGLE_CLIENT_ID=
RESEND_API_KEY=
SMTP_HOST=
SENTRY_DSN=
SENTRY_CLIENT_DSN=

# Non-secret test values, matching the CI approach. Not a working storage service.
S3_BUCKET=ci-bucket
S3_ENDPOINT=https://fake.example.com
S3_ACCESS_KEY_ID=ci-access-key
S3_SECRET_ACCESS_KEY=ci-secret-key
S3_PUBLIC_URL=https://fake.example.com/ci-bucket

{
  "name": "arkyvree",
  "private": true,
  "version": "0.0.0",
  "license": "Elastic-2.0",
  "type": "module",
  "overrides": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "pdfkit": "0.20.2"
  },
  "scripts": {
    "dev:db": "docker compose up postgres-dev --wait",
    "dev:db:stop": "docker compose down postgres-dev",
    "dev:db:reset": "bun --env-file=.env scripts/db/reset.ts --with-test-data",
    "dev:db:studio": "drizzle-kit studio",
    "dev:db:pull": "drizzle-kit pull && oxlint --fix --fix-suggestions drizzle/schema.ts drizzle/relations.ts && oxfmt drizzle/schema.ts drizzle/relations.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:packages": "bun --env-file=.env scripts/db/apply-packages.ts",
    "dev:mail": "docker compose up mailpit -d",
    "dev:mail:stop": "docker compose down mailpit",
    "dev:server": "bun --watch server/main.ts",
    "dev:worker": "bun --watch server/worker.ts",
    "dev:client": "bun vite",
    "dev:frontend": "bun vite",
    "dev:email": "email dev",
    "dev": "bun dev:server & bun dev:worker & bun dev:client",
    "build": "vite build",
    "build:deploy": "vite build && bun build server/main.ts --compile --external pdfkit --compile-autoload-package-json --outfile server-bin && bun build scripts/db/migrate.ts --compile --external pdfkit --compile-autoload-package-json --outfile migrate-bin",
    "start": "bun server/main.ts",
    "serve": "bun run build && bun start",
    "test:db": "docker compose up postgres-test --wait",
    "test:db:stop": "docker compose down postgres-test",
    "test:db:reset": "bun --env-file=.env.test scripts/db/reset.ts --with-test-data && bun --env-file=.env.test scripts/db/clone-database.ts e2e",
    "test": "bun --env-file=.env.test scripts/db/provision-test-dbs.ts --workers 6 && bun --env-file=.env.test test --parallel=6 tests",
    "test:changed": "bun --env-file=.env.test test --changed=$(scripts/parent-branch.sh) tests",
    "test:sequential": "bun --env-file=.env.test test tests",
    "test:coverage": "bun --env-file=.env.test test --coverage tests",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:e2e:codegen": "playwright codegen http://localhost:5173",
    "test:all": "bun run test && bun test:e2e",
    "prod:impersonate": "bun --env-file=.env.production scripts/ops/impersonate.ts",
    "prod:neon-usage": "bun --env-file=.env.production scripts/ops/neon-usage.ts",
    "prod:diff": "bun --env-file=.env.production scripts/ops/diff/diff-prod.ts",
    "prod:validate-characters": "bun --env-file=.env.production scripts/ops/validate-characters.ts",
    "parser:dnd3.5:scrape": "bun codegen/dnd3.5/tools/cli/scrape.ts",
    "parser:dnd3.5:generate": "bun codegen/dnd3.5/tools/cli/generate.ts",
    "parser:dnd3.5:sync": "bun codegen/dnd3.5/tools/cli/sync.ts",
    "parser:dnd3.5:overrides": "bun codegen/dnd3.5/tools/cli/overrides.ts",
    "parser:dnd3.5:validate": "bun codegen/dnd3.5/tools/cli/validate.ts",
    "parser:pf1:scrape": "bun codegen/pf1/tools/cli/scrape.ts",
    "parser:pf1:generate": "bun codegen/pf1/tools/cli/generate.ts",
    "lint": "oxlint --report-unused-disable-directives-severity=error",
    "lint:fix": "oxlint --fix --report-unused-disable-directives-severity=error",
    "format": "oxfmt '**/*.{ts,tsx,js,mjs,cjs}'",
    "format:check": "oxfmt --check '**/*.{ts,tsx,js,mjs,cjs}'",
    "test:pdf-bundle": "bun scripts/check-pdf-bundle.ts"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource-variable/lora": "^5.3.0",
    "@hono/otel": "^1.3.0",
    "@hono/zod-validator": "^0.9.1",
    "@modelcontextprotocol/server": "2.4.0",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@mui/x-tree-view": "^9.17.0",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/api-logs": "^0.222.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.222.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.222.0",
    "@opentelemetry/host-metrics": "^0.39.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-logs": "^0.222.0",
    "@opentelemetry/sdk-metrics": "^2.12.0",
    "@opentelemetry/semantic-conventions": "^1.45.0",
    "@popperjs/core": "^2.11.8",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.2.0",
    "@react-pdf/renderer": "^4.9.0",
    "@sentry/bun": "^10.78.0",
    "@sentry/react": "^10.78.0",
    "@tanstack/react-query": "^5.106.1",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "graphile-worker": "^0.18.0",
    "hono": "^4.13.16",
    "hono-rate-limiter": "^0.5.4",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "postgres": "^3.4.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-email": "^6.11.8",
    "react-hook-form": "^7.91.0",
    "react-router-dom": "^7.18.5",
    "resend": "^6.37.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "@vitejs/plugin-react": "^6.2.1",
    "bun-types": "^1.4.4",
    "cheerio": "^1.2.0",
    "domhandler": "^5.0.3",
    "drizzle-kit": "^0.31.11",
    "glob": "^13.0.7",
    "monocart-coverage-reports": "^2.13.2",
    "oxfmt": "^0.71.0",
    "oxlint": "1.85.0",
    "playwright": "^1.65.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^1.3.0"
  }
}

{
  "attribution": {
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "mcp__Neon__run_sql"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/scripts/cloud/session-start.sh",
            "timeout": 600
          }
        ]
      }
    ]
  }
}

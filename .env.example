# Local development only. Copy to .env; never use these values in production.
NODE_ENV=development
DATABASE_URL=postgresql://devuser:devpass@localhost:5432/arkyvree_dev
PORT=8000
WORKER_PORT=8001
HOST=localhost
APP_URL=http://localhost:5173
SIGNING_SECRET=local-development-only-change-before-deploying

# Local email: bun dev:mail (inbox at http://localhost:8025).
SMTP_HOST=localhost
SMTP_PORT=1025

# Optional external integrations. Leave empty for basic local development.
RESEND_API_KEY=
GOOGLE_CLIENT_ID=
FEATUREBASE_ENABLED=false
SENTRY_DSN=
SENTRY_CLIENT_DSN=

# Uploads require your own S3-compatible storage. Never commit real credentials.
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
